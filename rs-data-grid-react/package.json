{
  "name": "rs-data-grid-react",
  "version": "0.1.0",
  "description": "A configurable data grid component for React -- filtering, sorting, pagination, inline/popup/batch editing, drag-and-drop, and Excel/PDF export.",
  "license": "MIT",
  "keywords": [
    "react",
    "data-grid",
    "table",
    "grid"
  ],
  "type": "module",
  "main": "./dist-lib/rs-data-grid-react.cjs",
  "module": "./dist-lib/rs-data-grid-react.js",
  "types": "./dist-lib/rs-data-grid-react.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/rs-data-grid-react.d.ts",
      "import": "./dist-lib/rs-data-grid-react.js",
      "require": "./dist-lib/rs-data-grid-react.cjs"
    }
  },
  "files": [
    "dist-lib"
  ],
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rs-data-grid-react": "^0.1.0",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "predev": "test -d dist-lib || npm run build:lib",
    "dev": "vite",
    "prebuild": "test -d dist-lib || npm run build:lib",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts",
    "prebuild:single-spa": "test -d dist-lib || npm run build:lib",
    "build:single-spa": "vite build --config vite.single-spa.config.ts",
    "watch:single-spa": "vite build --config vite.single-spa.config.ts --watch",
    "serve:single-spa": "vite preview --config vite.single-spa.config.ts --port 3000 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build:lib"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.102.0",
    "single-spa-react": "^6.0.2",
    "typescript": "^4.9.5",
    "vite": "^8.2.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10",
    "web-vitals": "^2.1.4"
  }
}
